# Compose 使用仓库根目录作为构建上下文，因此敏感文件必须在根级排除。
.env
.env.*
!.env.example
!infra/staging/.env.staging.example
!infra/production/.env.production.example

# 本地解释器、缓存、运行数据和版本控制元数据不得发送给 Docker daemon。
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.git/
.gitignore
data/
backups/
infra/ragflow/

# 文档和知识库不属于 API 运行时构建输入。测试源码保留在上下文中，仅供
# 显式 report-tests 阶段复制；默认 final 阶段不会复制 tests 目录。
docs/
knowledge_base/

# 前端依赖和本地产物由镜像内 npm ci / npm run build 重新生成。
frontend/node_modules/
frontend/dist/

# 编辑器和系统临时文件不进入构建上下文。
.idea/
.vscode/
*.log
Thumbs.db
