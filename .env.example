APP_NAME=uPil API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# 本地开发使用 demo；生产可由 API 直接验证 OIDC JWT，或使用可信认证网关注入 Header。
AUTH_MODE=demo
AUTH_TRUSTED_PROXY_SECRET=
AUTH_USER_HEADER=X-Authenticated-User-ID
AUTH_ROLE_HEADER=X-Authenticated-Role
AUTH_PROXY_SECRET_HEADER=X-Auth-Proxy-Secret
# 直接 OIDC JWT 模式使用以下配置；本地 demo 可保持为空。
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URI=
AUTH_OIDC_ALGORITHMS=RS256
AUTH_OIDC_SUBJECT_CLAIM=sub
AUTH_OIDC_JWKS_CACHE_SECONDS=300
AUTH_OIDC_CLOCK_SKEW_SECONDS=30
AUTH_OIDC_HTTP_TIMEOUT_SECONDS=3
# 依赖健康检查默认按请求触发；预发布环境可显式开启启动检查。
DEPENDENCY_CHECK_ON_STARTUP=false
DEPENDENCY_CHECK_TIMEOUT_SECONDS=3
DATABASE_URL=postgresql+psycopg://upil:upil@localhost:5432/upil
MINIO_ENDPOINT=localhost:29000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_SECURE=false
# 仅在希望将报告对象存储纳入依赖健康检查时开启。
MINIO_ENABLED=false
# 固定模板 PDF 默认关闭；启用前先确认字体路径存在，并配置可访问的私有 MinIO。
REPORT_PDF_ENABLED=false
REPORT_PDF_FONT_PATH=C:\Windows\Fonts\NotoSansSC-VF.ttf
REPORT_PDF_MAX_BYTES=5242880
REPORT_PDF_MAX_PAGES=20
REPORT_PDF_TEMPLATE_VERSION=learning-report-pdf-v2
REPORT_PDF_BUCKET=upil-reports
RAGFLOW_BASE_URL=http://localhost:29380
RAGFLOW_API_KEY=
# 公开咨询 Assistant 的 Chat ID。
RAGFLOW_PUBLIC_CHAT_ID=
# 服务规则与异常处置 Assistant 的 Chat ID。
RAGFLOW_SERVICE_RULES_CHAT_ID=
RAGFLOW_TIMEOUT_SECONDS=15
# 家长端默认不返回 RAGFlow 文档名、片段和检索分数；仅内部审计时开启。
EXPOSE_SOURCES=false
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可为结构化路由选择独立模型；留空时复用 LLM_MODEL。Router 在代码中
# 固定 temperature=0，不受普通生成模型温度调整影响。
LLM_ROUTER_MODEL=
LEAD_INTENT_MODEL=
# 该温度供普通生成模型使用；Supervisor Router 和招生旁路均单独固定为 0。
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# 旁路 Agent 使用短超时；联系方式密钥为空时仅允许开发 Demo 派生值。
LEAD_INTENT_TIMEOUT_SECONDS=2
LEAD_CONTACT_ENCRYPTION_KEY=
LEAD_CONTACT_FINGERPRINT_KEY=
# 飞书只接收低敏线索提醒；Webhook 属于密钥，必须写入本地未提交 .env。
LEAD_NOTIFICATION_ENABLED=false
LEAD_NOTIFICATION_CHANNEL=feishu
LEAD_NOTIFICATION_MIN_LEVEL=high
FEISHU_WEBHOOK_URL=
LEAD_NOTIFICATION_MAX_RETRIES=3
LEAD_NOTIFICATION_RETRY_SECONDS=60
LEAD_NOTIFICATION_POLL_SECONDS=5
LEAD_NOTIFICATION_TIMEOUT_SECONDS=3
LEAD_NOTIFICATION_DETAIL_BASE_URL=http://127.0.0.1:18001
# uPil 使用独立 Redis 保存短期会话，不复用 RAGFlow 内部 Redis。复制到本地
# .env 后请把两个 change-me 替换为同一个随机密码；生产环境由 Secret Manager 注入。
UPIL_REDIS_PASSWORD=change-me-local-redis-password
CONVERSATION_STORE_BACKEND=redis
REDIS_URL=redis://:change-me-local-redis-password@localhost:16380/0
REDIS_TIMEOUT_SECONDS=0.5
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_ENTRIES=10000
CONVERSATION_RECENT_TURNS=8
CONVERSATION_SUMMARY_TOKEN_BUDGET=300
CONVERSATION_CONTEXT_TOKEN_BUDGET=1200
# 开启前必须先创建 agent_structured_memories 表；只保存受控低敏感偏好。
MEMORY_WRITE_ENABLED=true
EPISODIC_MEMORY_ENABLED=false
EPISODIC_EMBEDDING_MODEL=
