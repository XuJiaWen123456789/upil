APP_NAME=uPil API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# 本地开发使用 demo；接入完成身份校验的反向代理后改为 trusted_headers。
AUTH_MODE=demo
AUTH_TRUSTED_PROXY_SECRET=
AUTH_USER_HEADER=X-Authenticated-User-ID
AUTH_ROLE_HEADER=X-Authenticated-Role
AUTH_PROXY_SECRET_HEADER=X-Auth-Proxy-Secret
# 依赖健康检查默认按请求触发；预发布环境可显式开启启动检查。
DEPENDENCY_CHECK_ON_STARTUP=false
DEPENDENCY_CHECK_TIMEOUT_SECONDS=3
DATABASE_URL=postgresql+psycopg://upil:upil@localhost:5432/upil
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=upil-media
MINIO_REGION=us-east-1
MINIO_SECURE=false
# 仅在希望将 MinIO 纳入依赖健康检查时开启；媒体接口本身按请求使用 MinIO。
MINIO_ENABLED=false
MINIO_PRESIGNED_URL_SECONDS=600
MEDIA_MAX_BYTES=10485760
RAGFLOW_BASE_URL=http://localhost:19380
RAGFLOW_API_KEY=
# 公开咨询 Assistant 的 Chat ID；配置后优先于旧的 RAGFLOW_CHAT_ID。
RAGFLOW_PUBLIC_CHAT_ID=
# 服务规则与异常处置 Assistant 的 Chat ID。
RAGFLOW_SERVICE_RULES_CHAT_ID=
# 旧配置兼容字段；新环境建议改用上面两个按业务隔离的字段。
RAGFLOW_CHAT_ID=
RAGFLOW_TIMEOUT_SECONDS=15
# 家长端默认不返回 RAGFlow 文档名、片段和检索分数；仅内部审计时开启。
EXPOSE_SOURCES=false
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# 学情分析 A2A 增强默认关闭；local_http 只允许连接本机回环地址。
A2A_LEARNING_ENABLED=false
A2A_LEARNING_MODE=mock
A2A_LEARNING_BASE_URL=http://127.0.0.1:8101
# local_http 模式必须设置至少 16 个字符的随机内部服务令牌，不要提交真实值。
A2A_LEARNING_SERVICE_TOKEN=
A2A_LEARNING_TIMEOUT_SECONDS=10
A2A_LEARNING_MAX_RETRIES=2
A2A_LEARNING_TASK_TTL_SECONDS=1800
A2A_LEARNING_TASK_MAX_ENTRIES=1000
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_ENTRIES=10000
