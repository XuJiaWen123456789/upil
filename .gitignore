__pycache__/
*.py[cod]
.pytest_cache/
# pytest 缓存、临时数据库和历史测试运行产物统一放在此目录；这些内容
# 都可以由自动化测试重新生成，不应进入源码版本库。
.test-artifacts/
.venv/
.env

# Codex 本地修改备份与人工数据库备份可能包含历史配置或业务快照，
# 仅用于当前开发机恢复，不进入公开源码仓库。
.codex-backups/
backups/

# 以下目录是为了联调而拉取的外部开源项目完整副本。主项目只保留
# 自己编写的集成代码和配置，避免嵌套 Git 仓库、大文件与上游历史混入。
data/ragflow-upstream/
data/reference/knowledge_base/

# 本地运行数据、测试数据、服务日志均可重新生成。数据库文件不应进入
# Git，既可避免仓库膨胀，也可降低提交个人数据或演示账号信息的风险。
*.db
*.sqlite
*.sqlite3
*.log
data/pytest-local/
data/pytest-tmp/
.coverage
htmlcov/

# Python 可编辑安装生成的包元数据。
*.egg-info/

# 临时补丁备份和本机 Docker 客户端状态不属于项目源码。
*.bak
data/docker-config/
data/media-pending.json

# RAGFlow 与预发布环境的真实配置、运行日志只保留在部署机器上；
# 对应的 .env.example 模板仍会提交。
infra/ragflow/.env
# 上游项目的完整环境变量参考只供本机排障，其中包含大量上游默认
# 凭据；uPil 对外只维护经过裁剪和脱敏的 .env.example。
infra/ragflow/.env.upstream-reference
infra/ragflow/ragflow-logs/
infra/staging/.env.staging
.idea/
.vscode/
node_modules/
dist/
data/*.db
data/*.sqlite
data/*.sqlite3
