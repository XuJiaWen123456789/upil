{
  "name": "upil-web",
  "version": "1.0.0",
  "private": true,
  "description": "uPil 家长与教师双角色业务工作台",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:backend": "vue-tsc --noEmit && node scripts/build-backend.mjs",
