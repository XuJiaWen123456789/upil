# uPil 生产环境变量模板。复制到部署平台的 Secret/Config 管理界面后填写，
# 不要把填有真实密钥的文件提交到 Git，也不要直接使用开发环境默认凭据。
APP_NAME=uPil API
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 默认由 uPil 直接验证 OIDC Bearer Token；也可按部署架构改用 trusted_headers，禁止 demo。
AUTH_MODE=oidc_jwt
AUTH_TRUSTED_PROXY_SECRET=
AUTH_USER_HEADER=X-Authenticated-User-ID
AUTH_ROLE_HEADER=X-Authenticated-Role
AUTH_PROXY_SECRET_HEADER=X-Auth-Proxy-Secret
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URI=
AUTH_OIDC_ALGORITHMS=RS256
AUTH_OIDC_SUBJECT_CLAIM=sub
AUTH_OIDC_JWKS_CACHE_SECONDS=300
AUTH_OIDC_CLOCK_SKEW_SECONDS=30
AUTH_OIDC_HTTP_TIMEOUT_SECONDS=3

DEPENDENCY_CHECK_ON_STARTUP=true
DEPENDENCY_CHECK_TIMEOUT_SECONDS=3

# 以下连接和凭据必须由 Secret Manager 或部署平台注入。
DATABASE_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_SECURE=true
MINIO_ENABLED=true

# 学情报告二进制使用私有桶，只能由后端鉴权代理读取。
REPORT_PDF_ENABLED=true
REPORT_PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
REPORT_PDF_MAX_BYTES=5242880
REPORT_PDF_MAX_PAGES=20
REPORT_PDF_TEMPLATE_VERSION=learning-report-pdf-v2
REPORT_PDF_BUCKET=upil-reports

RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_PUBLIC_CHAT_ID=
RAGFLOW_SERVICE_RULES_CHAT_ID=
RAGFLOW_TIMEOUT_SECONDS=15
EXPOSE_SOURCES=false

# 模型能力按部署审批开启；关闭时系统使用受控降级，不应内置真实密钥。
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可按成本和准确率为 Supervisor 选择独立模型；留空时复用 LLM_MODEL。
# Router 与招生旁路温度由代码固定为 0，本字段不影响它们。
LLM_ROUTER_MODEL=
LEAD_INTENT_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LEAD_INTENT_TIMEOUT_SECONDS=2
# 两个值都必须由 Secret Manager 注入；禁止复用 OIDC、数据库或 MinIO 密钥。
LEAD_CONTACT_ENCRYPTION_KEY=
LEAD_CONTACT_FINGERPRINT_KEY=
# 生产 Webhook 和外部入口由 Secret Manager 注入，仓库模板禁止出现真实值。
LEAD_NOTIFICATION_ENABLED=false
LEAD_NOTIFICATION_CHANNEL=feishu
LEAD_NOTIFICATION_MIN_LEVEL=high
FEISHU_WEBHOOK_URL=
LEAD_NOTIFICATION_MAX_RETRIES=3
LEAD_NOTIFICATION_RETRY_SECONDS=60
LEAD_NOTIFICATION_POLL_SECONDS=5
LEAD_NOTIFICATION_TIMEOUT_SECONDS=3
LEAD_NOTIFICATION_DETAIL_BASE_URL=

# 多实例 API 必须使用独立 Redis 共享短期会话。完整 REDIS_URL 属于密钥，
# 由 Secret Manager 注入，不能写入镜像、源码或部署日志。
CONVERSATION_STORE_BACKEND=redis
REDIS_URL=
REDIS_TIMEOUT_SECONDS=0.5
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_ENTRIES=10000
CONVERSATION_RECENT_TURNS=8
CONVERSATION_SUMMARY_TOKEN_BUDGET=300
CONVERSATION_CONTEXT_TOKEN_BUDGET=1200
# 发布前必须执行 007_add_agent_memory.sql；写入失败不会阻断主聊天。
MEMORY_WRITE_ENABLED=true
EPISODIC_MEMORY_ENABLED=false
EPISODIC_EMBEDDING_MODEL=
