# uPil 生产环境变量模板。复制到部署平台的 Secret/Config 管理界面后填写，
# 不要把填有真实密钥的文件提交到 Git，也不要直接使用开发环境默认凭据。
APP_NAME=uPil API
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 生产环境必须位于完成用户登录的可信认证代理之后，禁止改为 demo。
AUTH_MODE=trusted_headers
AUTH_TRUSTED_PROXY_SECRET=
AUTH_USER_HEADER=X-Authenticated-User-ID
AUTH_ROLE_HEADER=X-Authenticated-Role
AUTH_PROXY_SECRET_HEADER=X-Auth-Proxy-Secret

DEPENDENCY_CHECK_ON_STARTUP=true
DEPENDENCY_CHECK_TIMEOUT_SECONDS=3

# 以下连接和凭据必须由 Secret Manager 或部署平台注入。
DATABASE_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=upil-media
MINIO_REGION=us-east-1
MINIO_SECURE=true
MINIO_ENABLED=true
MINIO_PRESIGNED_URL_SECONDS=600
MEDIA_MAX_BYTES=10485760

RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_PUBLIC_CHAT_ID=
RAGFLOW_SERVICE_RULES_CHAT_ID=
RAGFLOW_CHAT_ID=
RAGFLOW_TIMEOUT_SECONDS=15
EXPOSE_SOURCES=false

# 模型能力按部署审批开启；关闭时系统使用受控降级，不应内置真实密钥。
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# 当前仓库中的 A2A 节点仍是受控 Mock/HTTP 合同实现，生产模板默认关闭。
A2A_LEARNING_ENABLED=false
A2A_LEARNING_MODE=local_http
A2A_LEARNING_BASE_URL=
A2A_LEARNING_ALLOWED_HOSTS=
A2A_LEARNING_SERVICE_TOKEN=
A2A_LEARNING_TIMEOUT_SECONDS=10
A2A_LEARNING_MAX_RETRIES=2
A2A_LEARNING_TASK_TTL_SECONDS=1800
A2A_LEARNING_TASK_MAX_ENTRIES=1000

# 当前实现仍为单进程 Store；多实例部署前必须替换为 Redis/PostgreSQL。
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_ENTRIES=10000
