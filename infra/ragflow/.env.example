# RAGFlow 本地开发配置模板；复制为 .env 后再按环境修改。
DOC_ENGINE=elasticsearch
DB_TYPE=mysql
DEVICE=cpu
METADATA_DB_PROFILE=mysql
COMPOSE_PROFILES=elasticsearch,cpu,metadata-mysql
STACK_VERSION=8.11.3
ES_HOST=es01
ES_PORT=1200
ES_USER=elastic
ELASTIC_PASSWORD=change_me
MEM_LIMIT=1536m
MYSQL_HOST=mysql
MYSQL_PORT=3306
EXPOSE_MYSQL_PORT=13306
MYSQL_DBNAME=rag_flow
MYSQL_USER=root
MYSQL_PASSWORD=change_me
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_PASSWORD=change_me
MINIO_HOST=upil-minio
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=ragflow-data
MINIO_PREFIX_PATH=ragflow
SVR_WEB_HTTP_PORT=9080
SVR_WEB_HTTPS_PORT=9443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
GO_HTTP_PORT=9384
GO_ADMIN_PORT=9383
RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.1
ADMIN_DEFAULT_PASSWORD=change_me
API_PROXY_SCHEME=python
ALLOW_ANY_HOST=0
TZ=Asia/Shanghai
DOC_BULK_SIZE=2
EMBEDDING_BATCH_SIZE=4
OS_PORT=1201
OPENSEARCH_PASSWORD=change_me
SERENEDB_PORT=7890
SERENEDB_PASSWORD=change_me
INFINITY_THRIFT_PORT=23817
INFINITY_HTTP_PORT=23820
INFINITY_PSQL_PORT=5432
