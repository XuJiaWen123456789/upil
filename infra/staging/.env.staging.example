# uPil 本地预发布环境示例；复制为 .env.staging 后再填写本机配置。
# 不要把真实 API Key、密码或服务 Token 提交到代码仓库。
APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 当前本地 staging 没有认证网关，因此默认保留 demo。接入网关后必须改为
# trusted_headers，并通过未提交的 .env.staging 注入随机共享密钥。
AUTH_MODE=demo
AUTH_TRUSTED_PROXY_SECRET=
AUTH_USER_HEADER=X-Authenticated-User-ID
AUTH_ROLE_HEADER=X-Authenticated-Role
AUTH_PROXY_SECRET_HEADER=X-Auth-Proxy-Secret
DEPENDENCY_CHECK_ON_STARTUP=false
DEPENDENCY_CHECK_TIMEOUT_SECONDS=3

# staging 使用 Docker Compose 中的 PostgreSQL；应用容器内使用服务名访问。
DATABASE_URL=postgresql+psycopg://upil:change-me@postgres:5432/upil
MINIO_ENDPOINT=minio:9000
# 这两个值必须与根 Compose 启动 MinIO 时的 MINIO_ROOT_USER/PASSWORD 一致。
# 不要把真实值提交到仓库；本机 .env.staging 使用实际凭据填写。
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=upil-media
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_ENABLED=true

# RAGFlow 和模型密钥必须通过本地未提交文件或密钥管理系统注入。
RAGFLOW_BASE_URL=http://ragflow-cpu:9380
RAGFLOW_API_KEY=
RAGFLOW_PUBLIC_CHAT_ID=
RAGFLOW_SERVICE_RULES_CHAT_ID=
RAGFLOW_CHAT_ID=
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# A2A 服务默认关闭；启用 local_http 时改为 Compose 内部服务地址并设置随机 Token。
A2A_LEARNING_ENABLED=true
A2A_LEARNING_MODE=local_http
A2A_LEARNING_BASE_URL=http://upil-a2a-learning:8101
# 只有 staging 显式允许该 Docker 服务名；开发环境默认仍只允许回环地址。
A2A_LEARNING_ALLOWED_HOSTS=upil-a2a-learning
A2A_LEARNING_SERVICE_TOKEN=
A2A_LEARNING_TIMEOUT_SECONDS=10
A2A_LEARNING_MAX_RETRIES=2
A2A_LEARNING_TASK_TTL_SECONDS=1800
A2A_LEARNING_TASK_MAX_ENTRIES=1000
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_ENTRIES=10000
