# uPil 本地预发布环境示例；复制为 .env.staging 后再填写本机配置。
# 不要把真实 API Key、密码或服务 Token 提交到代码仓库。
APP_NAME=uPil API
APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 当前本地 staging 没有认证网关，因此默认保留 demo。接入网关后必须改为
# trusted_headers，并通过未提交的 .env.staging 注入随机共享密钥。
AUTH_MODE=demo
AUTH_TRUSTED_PROXY_SECRET=
AUTH_USER_HEADER=X-Authenticated-User-ID
AUTH_ROLE_HEADER=X-Authenticated-Role
AUTH_PROXY_SECRET_HEADER=X-Auth-Proxy-Secret
# 连接测试身份提供方时可切换 AUTH_MODE=oidc_jwt 并填写以下值。
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URI=
AUTH_OIDC_ALGORITHMS=RS256
AUTH_OIDC_SUBJECT_CLAIM=sub
AUTH_OIDC_JWKS_CACHE_SECONDS=300
AUTH_OIDC_CLOCK_SKEW_SECONDS=30
AUTH_OIDC_HTTP_TIMEOUT_SECONDS=3
DEPENDENCY_CHECK_ON_STARTUP=false
DEPENDENCY_CHECK_TIMEOUT_SECONDS=3

# staging 使用 Docker Compose 中的 PostgreSQL；应用容器内使用服务名访问。
DATABASE_URL=postgresql+psycopg://upil:change-me@postgres:5432/upil
MINIO_ENDPOINT=minio:9000
# 这两个值必须与根 Compose 启动 MinIO 时的 MINIO_ROOT_USER/PASSWORD 一致。
# 不要把真实值提交到仓库；本机 .env.staging 使用实际凭据填写。
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_ENABLED=true
REPORT_PDF_ENABLED=true
# 容器镜像必须把经过授权的中文字体安装或挂载到该路径。
REPORT_PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
REPORT_PDF_MAX_BYTES=5242880
REPORT_PDF_MAX_PAGES=20
REPORT_PDF_TEMPLATE_VERSION=learning-report-pdf-v2
REPORT_PDF_BUCKET=upil-reports

# RAGFlow 和模型密钥必须通过本地未提交文件或密钥管理系统注入。
RAGFLOW_BASE_URL=http://ragflow-cpu:9380
RAGFLOW_API_KEY=
RAGFLOW_PUBLIC_CHAT_ID=
RAGFLOW_SERVICE_RULES_CHAT_ID=
RAGFLOW_TIMEOUT_SECONDS=15
EXPOSE_SOURCES=false
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选专用 Router；留空时复用 LLM_MODEL，Router 温度仍由代码固定为 0。
LLM_ROUTER_MODEL=
LEAD_INTENT_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LEAD_INTENT_TIMEOUT_SECONDS=2
# staging 仅可使用本地虚构联系方式；真实数据必须由密钥管理系统注入。
LEAD_CONTACT_ENCRYPTION_KEY=
LEAD_CONTACT_FINGERPRINT_KEY=
# 启用前先执行 009 迁移。Webhook 只能由未提交配置或 Secret 注入。
LEAD_NOTIFICATION_ENABLED=false
LEAD_NOTIFICATION_CHANNEL=feishu
LEAD_NOTIFICATION_MIN_LEVEL=high
FEISHU_WEBHOOK_URL=
LEAD_NOTIFICATION_MAX_RETRIES=3
LEAD_NOTIFICATION_RETRY_SECONDS=60
LEAD_NOTIFICATION_POLL_SECONDS=5
LEAD_NOTIFICATION_TIMEOUT_SECONDS=3
LEAD_NOTIFICATION_DETAIL_BASE_URL=http://127.0.0.1:18001

# Redis 密码必须与启动根 Compose 时未提交 .env 中的 UPIL_REDIS_PASSWORD 一致。
# API 容器走 Docker 内部网络，不使用宿主机映射端口 16380。
CONVERSATION_STORE_BACKEND=redis
REDIS_URL=redis://:change-me@upil-redis:6379/0
REDIS_TIMEOUT_SECONDS=0.5
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_ENTRIES=10000
CONVERSATION_RECENT_TURNS=8
CONVERSATION_SUMMARY_TOKEN_BUDGET=300
CONVERSATION_CONTEXT_TOKEN_BUDGET=1200
# staging 启动前执行 007_add_agent_memory.sql。
MEMORY_WRITE_ENABLED=true
EPISODIC_MEMORY_ENABLED=false
EPISODIC_EMBEDDING_MODEL=
